# ==============================================================================
# ResearchAI Environment Variables Template
# Copy this file to .env and populate with your own credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Application & API Gateway Settings
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=research_assistant
# Connection, server selection, and socket timeout in milliseconds
MONGODB_TIMEOUT_MS=5000

# Upload file limit in bytes (25 MiB); keep the frontend limit in sync
MAX_UPLOAD_SIZE_BYTES=26214400

# RabbitMQ Message Broker Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# LlamaParse Configuration (PDF parsing)
# Obtain from https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=your_llamaparse_api_key_here
# Unified LlamaParse v2 SDK; calls may consume provider credits
LLAMA_PARSE_TIMEOUT_SECONDS=300
LLAMA_PARSE_TIER=agentic
# Set a provider-supported fixed version for reproducible extraction
LLAMA_PARSE_VERSION=latest

# Voyage AI Configuration (Embeddings)
# Obtain from https://www.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-3

# LLM Configuration (Summarization & Chatbot)
# Choose your preferred provider and insert the respective key
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
