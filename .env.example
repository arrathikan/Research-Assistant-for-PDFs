# ==============================================================================
# ResearchAI Environment Variables Template
# Copy this file to .env and populate with your own credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Application & API Gateway Settings
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=research_assistant
# Connection, server selection, and socket timeout in milliseconds
MONGODB_TIMEOUT_MS=5000

# Upload file limit in bytes (25 MiB); keep the frontend limit in sync
MAX_UPLOAD_SIZE_BYTES=26214400

# RabbitMQ Message Broker Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# Durable processing queues; keep names/config identical across workers
INGESTION_QUEUE=document_ingestion_queue
SUMMARY_QUEUE=document_summary_queue
DLQ_QUEUE=document_dlq
RABBITMQ_HEARTBEAT_SECONDS=60
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10
WORKER_ACK_TIMEOUT_MS=7200000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=300
JOB_POLL_SECONDS=2
JOB_LEASE_SECONDS=300
JOB_HEARTBEAT_SECONDS=30

# LlamaParse Configuration (PDF parsing)
# Obtain from https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=your_llamaparse_api_key_here
# Unified LlamaParse v2 SDK; calls may consume provider credits
LLAMA_PARSE_TIMEOUT_SECONDS=300
LLAMA_PARSE_TIER=agentic
# Set a provider-supported fixed version for reproducible extraction
LLAMA_PARSE_VERSION=latest

# Voyage AI (direct embedding and future reranking calls)
# Obtain from https://www.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
VOYAGE_RERANKER_MODEL=rerank-2.5
EMBEDDING_DIMENSIONS=1024
# Legacy VOYAGE_MODEL / VOYAGE_DIMENSIONS remain supported as fallback names.
VOYAGE_BATCH_SIZE=16
VOYAGE_MAX_INPUT_BYTES=12000
VOYAGE_MAX_BATCH_BYTES=96000
VOYAGE_TIMEOUT_SECONDS=30
VOYAGE_RETRY_ATTEMPTS=2
VOYAGE_RETRY_BACKOFF_SECONDS=1
VECTOR_SEARCH_INDEX_NAME=chunk_embeddings_v1
SEMANTIC_TOP_K=5
VECTOR_NUM_CANDIDATES=100
KEYWORD_SEARCH_INDEX_NAME=chunk_keywords_v1
RAG_CANDIDATE_K=20
RAG_CONTEXT_K=6
RAG_RRF_CONSTANT=60
RAG_CONTEXT_BYTES=32000
RAG_HISTORY_TURNS=6

# OpenRouter (single gateway for future summary and chatbot completion calls)
# Obtain from https://openrouter.ai/keys; never put this key in OPENAI_API_KEY
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_APP_URL=https://verdeai.local
OPENROUTER_APP_NAME=VerdeAI
LLM_PROVIDER=openrouter
PRIMARY_REASONING_MODEL=openai/gpt-5.6-luna
CHEAP_REASONING_MODEL=meta-llama/llama-3.3-70b-instruct
VISION_MODEL=mistralai/mistral-small-3.1-24b-instruct
LLM_MAX_RETRIES=3
# GPT-5 models use low reasoning effort; temperature is omitted for compatibility.
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
# Conservative UTF-8 byte guard for source/notes JSON per summary window, not tokens
SUMMARY_CONTEXT_BYTES=48000
SUMMARY_MAX_WINDOWS=64
SUMMARY_VALIDATION_RETRIES=2

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Markdown chunking character limits (not token counts)
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Optional offline evaluation (never called by normal chat requests)
EVAL_JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct
EVAL_TEMPERATURE=0.1
EVAL_TIMEOUT_SECONDS=60
EVAL_METRIC_TIMEOUT_SECONDS=180
EVAL_MAX_OUTPUT_TOKENS=2048
EVAL_MAX_WORKERS=2
EVAL_MAX_LLM_REQUESTS=1000
EVAL_MAX_EMBEDDING_INPUTS=200
EVAL_RELEVANCY_QUESTIONS=3
EVAL_MAX_SAMPLES=20
